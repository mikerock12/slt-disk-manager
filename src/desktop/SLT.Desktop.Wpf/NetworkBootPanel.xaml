<UserControl x:Class="SLT.Desktop.NetworkBootPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="1120">
  <DockPanel Margin="0,0,0,8"><TextBlock Text="Servidor de boot pela rede" FontSize="23" FontWeight="SemiBold"/><Button x:Name="RefreshButton" Content="Atualizar estado" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="Refresh_Click"/></DockPanel>
  <TextBlock Text="Inicie o SLT Rescue pela Ethernet da bancada. O serviço fica desligado até uma ação local explícita. Inicializar pela rede não autoriza gravações: pareamento, plano assinado e confirmação local continuam obrigatórios." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
  <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,0,16"><StackPanel>
   <TextBlock x:Name="ServiceStatus" Text="ESTADO NÃO CONSULTADO" FontSize="18" FontWeight="SemiBold"/>
   <TextBlock x:Name="ServiceDetails" Text="Conecte ao Controller e consulte o estado. Nenhum serviço é iniciado ao abrir esta aba." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
   <TextBlock x:Name="ServiceError" TextWrapping="Wrap" Foreground="#FFD4A3" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <TextBlock Text="1. Rede Ethernet autorizada" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Grid x:Name="ConfigFields"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,14,0"><TextBlock Text="Interface do servidor" Style="{StaticResource Caption}"/><ComboBox x:Name="Interface" DisplayMemberPath="Label" SelectionChanged="Interface_SelectionChanged" Margin="0,0,0,10"/><TextBlock Text="IPv4 privado da interface" Style="{StaticResource Caption}"/><TextBox x:Name="BindIPv4" TextChanged="ConfigurationChanged" Margin="0,0,0,10"/><TextBlock Text="CIDR permitido da bancada" Style="{StaticResource Caption}"/><TextBox x:Name="AllowedCidr" TextChanged="ConfigurationChanged" Margin="0,0,0,10"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Modo de DHCP" Style="{StaticResource Caption}"/><ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="Mode_SelectionChanged" Margin="0,0,0,10"><ComboBoxItem Content="DHCP externo — configuração manual do roteador" Tag="EXTERNAL_DHCP"/></ComboBox><TextBlock Text="Porta HTTP dos arquivos de boot" Style="{StaticResource Caption}"/><TextBox x:Name="HttpPort" Text="8088" TextChanged="ConfigurationChanged" Margin="0,0,0,10"/><TextBlock Text="Armazenamento de boot separado" Style="{StaticResource Caption}"/><TextBlock x:Name="BootStore" Text="Gerenciado pelo servidor" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/></StackPanel>
  </Grid>
  <TextBlock x:Name="DhcpInstructions" Text="O DHCP existente continua fornecendo IP. Configure next-server e bootfile BIOS/UEFI no equipamento de rede seguindo o guia operacional; o SLT não altera o roteador nem distribui concessões de IP." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
  <WrapPanel Margin="0,0,0,10"><Button x:Name="SaveButton" Content="Salvar configuração" Style="{StaticResource SecondaryButton}" Click="Save_Click"/><Button x:Name="ValidateButton" Content="Validar rede e artefatos" Style="{StaticResource SecondaryButton}" Click="Validate_Click"/></WrapPanel>
  <TextBlock x:Name="ValidationResult" Text="Salve e valide a configuração antes de iniciar." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
  <CheckBox x:Name="NetworkConsent" Content="Conferi a interface e autorizo distribuir boot nesta rede de bancada." Margin="0,0,0,12" Click="Consent_Click"/>
  <WrapPanel Margin="0,0,0,20"><Button x:Name="StartButton" Content="Iniciar boot pela rede" IsEnabled="False" Click="Start_Click"/><Button x:Name="StopButton" Content="Parar distribuição de boot" IsEnabled="False" Style="{StaticResource SecondaryButton}" Click="Stop_Click"/></WrapPanel>
  <TextBlock Text="2. Perfis e compatibilidade" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <TextBlock Text="Importe o manifesto local do pacote SLT Rescue Netboot. As imagens de instalação ISO/WIM/ESD têm outro catálogo. WinPE PXE, instalação sem scratch e Secure Boot só serão oferecidos após validações próprias." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ManifestPath" ToolTip="Manifesto do pacote de boot no servidor" Margin="0,0,10,0"/><Button Grid.Column="1" Content="Escolher manifesto…" Style="{StaticResource SecondaryButton}" Click="PickManifest_Click"/><Button x:Name="ImportButton" Grid.Column="2" Content="Importar perfil" Click="Import_Click"/></Grid>
  <DataGrid x:Name="Profiles" Height="170" Margin="0,0,0,10" SelectionChanged="Profile_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Perfil" Binding="{Binding DisplayName}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="140"/><DataGridTextColumn Header="Firmware / arquitetura" Binding="{Binding FirmwareLabel}" Width="190"/><DataGridTextColumn Header="Secure Boot" Binding="{Binding SecureBootStatus}" Width="135"/><DataGridTextColumn Header="Validação" Binding="{Binding ValidationStatus}" Width="150"/><DataGridTextColumn Header="Habilitado" Binding="{Binding EnabledLabel}" Width="95"/></DataGrid.Columns></DataGrid>
  <Button x:Name="ToggleProfileButton" Content="Habilitar / desabilitar perfil selecionado" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="ToggleProfile_Click" IsEnabled="False" Margin="0,0,0,16"/>
  <TextBlock Text="Eventos do serviço" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <DataGrid x:Name="Events" Height="170"><DataGrid.Columns><DataGridTextColumn Header="Data local" Binding="{Binding When}" Width="165"/><DataGridTextColumn Header="Evento" Binding="{Binding Event}" Width="180"/><DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" MinWidth="250"/></DataGrid.Columns></DataGrid>
  <TextBlock x:Name="Status" Text="A consulta de estado não inicia PXE. Após parar, novos boots deixam de receber arquivos; jobs autenticados do Controller continuam independentes." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,10"/>
 </StackPanel></ScrollViewer>
</UserControl>
