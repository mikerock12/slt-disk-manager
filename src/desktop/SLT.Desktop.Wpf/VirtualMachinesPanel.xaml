<UserControl x:Class="SLT.Desktop.VirtualMachinesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <DockPanel Margin="0,0,0,6">
    <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource SecondaryButton}" Margin="0" Click="Refresh_Click"/>
    <TextBlock Text="Máquinas virtuais no servidor" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Style="{StaticResource PageHint}" TextWrapping="Wrap" Margin="0,0,0,10" Text="Usa o Hyper-V do Windows. UEFI = geração 2 (GPT); Legacy = geração 1 (BIOS/MBR). Entregue um HD ligado ao servidor à máquina virtual para instalar o Windows ou o Linux nele, configurar e instalar programas; depois é só colocar o HD no computador do cliente e atualizar os drivers."/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12"><TextBlock x:Name="HostStatus" Text="Consultando o Hyper-V…" TextWrapping="Wrap"/></Border>
   <TextBlock Text="Nova máquina virtual" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
   <Border Style="{StaticResource Card}" Margin="0,0,0,12">
    <StackPanel>
     <WrapPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Nome" Style="{StaticResource Caption}"/><TextBox x:Name="VmName" Width="200" MaxLength="40" Text="SLT-VM"/></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Inicialização" Style="{StaticResource Caption}"/><ComboBox x:Name="Firmware" Width="230" SelectedIndex="0" SelectionChanged="Firmware_SelectionChanged"><ComboBoxItem Content="UEFI (geração 2, GPT)" Tag="2"/><ComboBoxItem Content="Legacy/BIOS (geração 1, MBR)" Tag="1"/></ComboBox></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock x:Name="MemoryCaption" Text="Memória RAM: 4096 MB" Style="{StaticResource Caption}"/><Slider x:Name="Memory" Width="230" Minimum="512" Maximum="8192" Value="4096" TickFrequency="512" IsSnapToTickEnabled="True" ValueChanged="Memory_ValueChanged"/></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Processadores virtuais" Style="{StaticResource Caption}"/><ComboBox x:Name="CpuCount" Width="90"/></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock x:Name="CpuCaption" Text="Uso máximo do processador: 50%" Style="{StaticResource Caption}"/><Slider x:Name="CpuPercent" Width="230" Minimum="5" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Cpu_ValueChanged"/></StackPanel>
     </WrapPanel>
     <TextBlock Text="Disco da máquina virtual" Style="{StaticResource Caption}" Margin="0,4,0,4"/>
     <WrapPanel>
      <RadioButton x:Name="DiskNew" Content="Disco virtual novo (VHDX)" IsChecked="True" Margin="0,0,18,6" Foreground="{StaticResource TextBrush}"/>
      <RadioButton x:Name="DiskPhysical" Content="HD/SSD ligado ao servidor" Margin="0,0,18,6" Foreground="{StaticResource TextBrush}"/>
      <RadioButton x:Name="DiskExisting" Content="VHDX existente" Margin="0,0,18,6" Foreground="{StaticResource TextBrush}"/>
      <RadioButton x:Name="DiskNone" Content="Sem disco" Margin="0,0,18,6" Foreground="{StaticResource TextBrush}"/>
     </WrapPanel>
     <WrapPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Pasta do VHDX novo (em qual disco)" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="VhdFolder" Width="260" Text="D:\SLT VMs"/><Button Content="…" Style="{StaticResource SecondaryButton}" Click="PickFolder_Click" Margin="6,0,0,0"/></StackPanel></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Tamanho do VHDX (GB)" Style="{StaticResource Caption}"/><TextBox x:Name="VhdSize" Width="110" Text="64"/></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="HD/SSD do servidor (fica offline e vai para a VM)" Style="{StaticResource Caption}"/><ComboBox x:Name="PhysicalDisk" Width="330"/></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="VHDX existente" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ExistingVhd" Width="240"/><Button Content="…" Style="{StaticResource SecondaryButton}" Click="PickVhd_Click" Margin="6,0,0,0"/></StackPanel></StackPanel>
     </WrapPanel>
     <WrapPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="ISO de instalação (Windows ou Linux)" Style="{StaticResource Caption}"/><StackPanel Orientation="Horizontal"><TextBox x:Name="IsoPath" Width="330"/><Button Content="Procurar…" Style="{StaticResource SecondaryButton}" Click="PickIso_Click" Margin="6,0,0,0"/></StackPanel></StackPanel>
      <StackPanel Margin="0,0,14,8"><TextBlock Text="Rede" Style="{StaticResource Caption}"/><ComboBox x:Name="Switch" Width="200"/></StackPanel>
      <StackPanel Margin="0,0,14,8" x:Name="UefiOptions"><TextBlock Text="UEFI" Style="{StaticResource Caption}"/>
       <CheckBox x:Name="SecureBoot" Content="Inicialização segura" IsChecked="True" Foreground="{StaticResource TextBrush}"/>
       <ComboBox x:Name="SecureTemplate" Width="200" SelectedIndex="0" Margin="0,4,0,0"><ComboBoxItem Content="Para Windows" Tag="MicrosoftWindows"/><ComboBoxItem Content="Para Linux" Tag="MicrosoftUEFICertificateAuthority"/></ComboBox>
       <CheckBox x:Name="Tpm" Content="TPM virtual (Windows 11)" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
      </StackPanel>
     </WrapPanel>
     <Button Content="Criar máquina virtual…" HorizontalAlignment="Left" Click="Create_Click" Margin="0,6,0,0"/>
    </StackPanel>
   </Border>
   <DockPanel Margin="0,0,0,6">
    <TextBlock Text="Máquinas virtuais do SLT" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
   </DockPanel>
   <DataGrid x:Name="Machines" Height="220">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="140"/>
     <DataGridTextColumn Header="Estado" Binding="{Binding StateLabel}" Width="95"/>
     <DataGridTextColumn Header="Inicialização" Binding="{Binding Firmware}" Width="170"/>
     <DataGridTextColumn Header="Memória" Binding="{Binding Memory}" Width="90"/>
     <DataGridTextColumn Header="Processador" Binding="{Binding Cpu}" Width="230"/>
     <DataGridTextColumn Header="ISO" Binding="{Binding IsoName}" Width="150"/>
     <DataGridTextColumn Header="Discos" Binding="{Binding Disks}" Width="*" MinWidth="140"/>
    </DataGrid.Columns>
   </DataGrid>
   <WrapPanel Margin="0,10,0,0">
    <Button Content="Ligar" Click="Start_Click"/>
    <Button Content="Abrir a tela da VM" Style="{StaticResource SecondaryButton}" Click="Connect_Click"/>
    <Button Content="Desligar" Style="{StaticResource SecondaryButton}" Click="Stop_Click"/>
    <Button Content="Forçar desligamento" Style="{StaticResource SecondaryButton}" Click="TurnOff_Click"/>
    <Button Content="Trocar ISO…" Style="{StaticResource SecondaryButton}" Click="SetIso_Click"/>
    <Button Content="Ejetar ISO" Style="{StaticResource SecondaryButton}" Click="EjectIso_Click"/>
    <Button Content="Excluir…" Style="{StaticResource DangerButton}" Click="Delete_Click"/>
   </WrapPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
