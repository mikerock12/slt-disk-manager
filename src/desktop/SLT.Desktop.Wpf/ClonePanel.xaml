<UserControl x:Class="SLT.Desktop.ClonePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="620"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="250"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="1. ORIGEM — disco inteiro, todas as partições" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="SourceDevice" DisplayMemberPath="Label" SelectionChanged="SourceDevice_SelectionChanged" Padding="7" Margin="0,0,0,8"/><ComboBox x:Name="SourceDisk" DisplayMemberPath="Label" SelectionChanged="Disk_SelectionChanged" Padding="7"/><TextBlock x:Name="SourceSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="2. DESTINO — dados atuais serão sobrescritos" Foreground="#F0A55F" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="TargetDevice" DisplayMemberPath="Label" SelectionChanged="TargetDevice_SelectionChanged" Padding="7" Margin="0,0,0,8"/><ComboBox x:Name="TargetDisk" DisplayMemberPath="Label" SelectionChanged="Disk_SelectionChanged" Padding="7"/><TextBlock x:Name="TargetSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,14,0,10"><ComboBox x:Name="Strategy" SelectedIndex="1" Width="440" Padding="7" SelectionChanged="Strategy_SelectionChanged" Margin="0,0,10,0"><ComboBoxItem Content="EXACT_RAW — cópia exata, capacidades iguais" Tag="EXACT_RAW"/><ComboBoxItem Content="PRESERVE_LAYOUT — preservar layout, destino igual/maior" Tag="PRESERVE_LAYOUT"/><ComboBoxItem Content="FIT — adaptar NTFS/ext4 em cópia de trabalho" Tag="FIT"/></ComboBox><CheckBox x:Name="Consent" Content="Tenho autorização para capturar a origem e preparar este clone." Margin="0,0,10,0"/><Button x:Name="PlanButton" Content="Pré-verificar e planejar" Click="Plan_Click"/></WrapPanel>
  <Border Grid.Row="2" BorderBrush="#4C5665" BorderThickness="1" Padding="10" Margin="0,0,0,10"><TextBlock x:Name="PreviewSummary" Text="Selecione os discos. O servidor calcula compatibilidade e adaptação; o destino só será autorizado após a captura e validação da imagem." TextWrapping="Wrap"/></Border>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <DataGrid x:Name="SourcePartitions"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/><DataGridTextColumn Header="Partição origem" Binding="{Binding Name}" Width="*" MinWidth="140"/><DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="65"/><DataGridTextColumn Header="Início LBA" Binding="{Binding StartLba}" Width="100"/><DataGridTextColumn Header="Setores" Binding="{Binding LengthLba}" Width="100"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/></DataGrid.Columns></DataGrid>
    <DataGrid x:Name="TargetPartitions" Grid.Column="2"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="35"/><DataGridTextColumn x:Name="TargetPartitionNameColumn" Header="Destino atual — apagar" Binding="{Binding Name}" Width="*" MinWidth="220"/><DataGridTextColumn Header="FS" Binding="{Binding FileSystem}" Width="65"/><DataGridTextColumn Header="Início LBA" Binding="{Binding StartLba}" Width="100"/><DataGridTextColumn Header="Setores" Binding="{Binding LengthLba}" Width="100"/></DataGrid.Columns></DataGrid>
   </Grid>
   <TextBlock Grid.Row="1" Text="Sessões • captura → verificação → confirmação do destino → restauração" FontWeight="SemiBold" Margin="0,12,0,8"/>
   <DataGrid Grid.Row="2" x:Name="Sessions" SelectionChanged="Sessions_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Criada" Binding="{Binding Created}" Width="130"/><DataGridTextColumn Header="Origem" Binding="{Binding SourceName}" Width="130"/><DataGridTextColumn Header="Destino" Binding="{Binding TargetName}" Width="130"/><DataGridTextColumn Header="Estratégia" Binding="{Binding Strategy}" Width="180"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="230"/><DataGridTextColumn Header="Sessão" Binding="{Binding Id}" Width="*" MinWidth="140"/></DataGrid.Columns></DataGrid>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="SessionProgress" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/><WrapPanel><Button x:Name="ApproveSource" Content="3. Conferir e autorizar captura…" Click="ApproveSource_Click" IsEnabled="False"/><Button x:Name="PrepareTarget" Content="4. Preparar e autorizar destino…" Click="PrepareTarget_Click" IsEnabled="False"/><Button Content="Ver plano completo" Style="{StaticResource SecondaryButton}" Click="Details_Click"/><TextBlock Text="Restauração física exige também confirmação local no Rescue." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></WrapPanel></StackPanel>
 </Grid></ScrollViewer>
</UserControl>
