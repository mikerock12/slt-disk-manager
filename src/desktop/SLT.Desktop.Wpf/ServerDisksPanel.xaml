<UserControl x:Class="SLT.Desktop.ServerDisksPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*" MinHeight="120"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="110"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0.9*" MinHeight="100"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6">
   <Button DockPanel.Dock="Right" Content="Atualizar discos" Style="{StaticResource SecondaryButton}" Margin="0" Click="Refresh_Click"/>
   <TextBlock Text="Discos deste servidor" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBlock Grid.Row="1" x:Name="Hint" Style="{StaticResource PageHint}" TextWrapping="Wrap" Margin="0,0,0,10"
   Text="Pendrives, HDs e SSDs ligados a este computador. Discos com o Windows do servidor, o arquivo de paginação ou os dados do SLT ficam protegidos: para gravar neles use o Modo kamikaze. Toda gravação pede confirmação digitada."/>
  <DataGrid Grid.Row="2" x:Name="Disks" SelectionChanged="Disks_SelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="45"/>
    <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" MinWidth="170"/>
    <DataGridTextColumn Header="Capacidade" Binding="{Binding Size}" Width="105"/>
    <DataGridTextColumn Header="Conexão" Binding="{Binding Bus}" Width="105"/>
    <DataGridTextColumn Header="Tabela" Binding="{Binding Table}" Width="85"/>
    <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="90"/>
    <DataGridTextColumn Header="Saúde" Binding="{Binding Health}" Width="85"/>
    <DataGridTextColumn Header="Proteção" Binding="{Binding Protection}" Width="1.3*" MinWidth="200"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="3" Text="Partições do disco selecionado" Style="{StaticResource SectionTitle}" Margin="0,12,0,6"/>
  <DataGrid Grid.Row="4" x:Name="Partitions">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="45"/>
    <DataGridTextColumn Header="Letra" Binding="{Binding Letter}" Width="60"/>
    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="100"/>
    <DataGridTextColumn Header="Sistema" Binding="{Binding FileSystem}" Width="80"/>
    <DataGridTextColumn Header="Rótulo" Binding="{Binding Label}" Width="*" MinWidth="110"/>
    <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/>
    <DataGridTextColumn Header="Livre" Binding="{Binding Free}" Width="100"/>
    <DataGridTextColumn Header="Windows" Binding="{Binding WindowsLabel}" Width="75"/>
    <DataGridTextColumn Header="Proteção" Binding="{Binding Protection}" Width="*" MinWidth="150"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
   <StackPanel>
    <WrapPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Tabela" Style="{StaticResource Caption}"/><ComboBox x:Name="TableType" Width="90" SelectedIndex="0"><ComboBoxItem Content="GPT"/><ComboBoxItem Content="MBR"/></ComboBox></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Sistema de arquivos" Style="{StaticResource Caption}"/><ComboBox x:Name="FileSystem" Width="110" SelectedIndex="0"><ComboBoxItem Content="NTFS"/><ComboBoxItem Content="exFAT"/><ComboBoxItem Content="FAT32"/></ComboBox></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Rótulo" Style="{StaticResource Caption}"/><TextBox x:Name="VolumeLabel" Width="150" MaxLength="32"/></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Novo tamanho (GB, 0 = máximo)" Style="{StaticResource Caption}"/><TextBox x:Name="NewSize" Width="120" Text="0"/></StackPanel>
     <StackPanel Margin="0,0,12,6"><TextBlock Text="Destino do clone" Style="{StaticResource Caption}"/><ComboBox x:Name="CloneTarget" Width="300"/></StackPanel>
    </WrapPanel>
    <TextBlock Text="Disco inteiro" Style="{StaticResource Caption}" Margin="0,6,0,2"/>
    <WrapPanel>
     <Button Content="Verificar disco" Style="{StaticResource SecondaryButton}" Click="Check_Click" ToolTip="Saúde, SMART e verificação somente leitura dos volumes"/>
     <Button Content="Formatar disco…" Style="{StaticResource DangerButton}" Click="FormatDisk_Click" ToolTip="Apaga tudo e cria uma partição com a tabela e o sistema escolhidos"/>
     <Button Content="Converter GPT ⇄ MBR (apaga)…" Style="{StaticResource DangerButton}" Click="ConvertTable_Click"/>
     <Button Content="MBR → GPT sem perder dados…" Style="{StaticResource SecondaryButton}" Click="Mbr2Gpt_Click" ToolTip="MBR2GPT da Microsoft, para disco com Windows"/>
     <Button Content="Clonar para o destino…" Style="{StaticResource DangerButton}" Click="Clone_Click" ToolTip="Cópia bruta conferida por SHA256"/>
     <Button Content="Colocar offline" Style="{StaticResource SecondaryButton}" Click="Offline_Click"/>
     <Button Content="Colocar online" Style="{StaticResource SecondaryButton}" Click="Online_Click"/>
    </WrapPanel>
    <TextBlock Text="Partição selecionada" Style="{StaticResource Caption}" Margin="0,6,0,2"/>
    <WrapPanel>
     <Button Content="Formatar partição (mudar sistema de arquivos)…" Style="{StaticResource DangerButton}" Click="FormatVolume_Click"/>
     <Button Content="Redimensionar…" Style="{StaticResource SecondaryButton}" Click="Resize_Click"/>
     <Button Content="Corrigir erros (chkdsk)…" Style="{StaticResource SecondaryButton}" Click="RepairVolume_Click"/>
     <Button Content="Reparar inicialização (BCDBoot)…" Style="{StaticResource SecondaryButton}" Click="BootRepair_Click"/>
     <Button Content="Reparar Windows deste disco (SFC/DISM)…" Style="{StaticResource SecondaryButton}" Click="OfflineRepair_Click"/>
     <Button Content="Reparar Windows do servidor…" Style="{StaticResource SecondaryButton}" Click="OnlineRepair_Click"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <DockPanel Grid.Row="6" Margin="0,12,0,6">
   <Button DockPanel.Dock="Right" Content="Interromper clone" Style="{StaticResource SecondaryButton}" Margin="0" Click="CancelOperation_Click"/>
   <Button DockPanel.Dock="Right" Content="Ver registro" Style="{StaticResource SecondaryButton}" Click="ShowLog_Click"/>
   <TextBlock Text="Operações neste servidor" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
  </DockPanel>
  <DataGrid Grid.Row="7" x:Name="Operations" MouseDoubleClick="ShowLog_Click">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="110"/>
    <DataGridTextColumn Header="Operação" Binding="{Binding Title}" Width="2*" MinWidth="250"/>
    <DataGridTextColumn Header="Estado" Binding="{Binding StateLabel}" Width="150"/>
    <DataGridTextColumn Header="Progresso" Binding="{Binding ProgressLabel}" Width="190"/>
    <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*" MinWidth="160"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>
