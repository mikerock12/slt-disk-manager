<UserControl x:Class="SLT.Desktop.FilesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="670"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="BrowseDevice" DisplayMemberPath="Label" SelectionChanged="BrowseDevice_SelectionChanged" Padding="7" Margin="0,0,10,0"/><ComboBox x:Name="BrowseRoot" Grid.Column="1" DisplayMemberPath="DisplayLabel" SelectionChanged="BrowseRoot_SelectionChanged" Padding="7" Margin="0,0,10,0"/><CheckBox Grid.Column="2" x:Name="ReadConsent" Content="Tenho autorização para listar e copiar estes arquivos." VerticalAlignment="Center"/></Grid>
  <Grid Grid.Row="1" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="UpButton" Content="Subir" Style="{StaticResource SecondaryButton}" Click="Up_Click"/><TextBox Grid.Column="1" x:Name="RelativePath" ToolTip="Caminho relativo à raiz autorizada; vazio lista a raiz" Margin="0,0,10,0"/><Button x:Name="ListButton" Grid.Column="2" Content="Listar / atualizar" Click="List_Click"/><Button x:Name="NextButton" Grid.Column="3" Content="Próxima página" Style="{StaticResource SecondaryButton}" Click="Next_Click" IsEnabled="False"/><Button x:Name="CancelListButton" Grid.Column="4" Content="Cancelar listagem" Style="{StaticResource SecondaryButton}" Click="CancelList_Click" IsEnabled="False"/></Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DataGrid x:Name="Entries" SelectionMode="Extended" MouseDoubleClick="Entries_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Nome • duplo clique abre pasta" Binding="{Binding Name}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="105"/><DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Modificado" Binding="{Binding Modified}" Width="160"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,8"><Button Content="Adicionar seleção →" Click="AddSelection_Click"/><Button Content="Remover" Style="{StaticResource SecondaryButton}" Click="RemoveSelection_Click"/></WrapPanel><ListBox x:Name="Basket" Grid.Row="1" DisplayMemberPath="Label" Background="#151B23" Foreground="#F1F3F7" BorderBrush="#35404F"/><StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBox x:Name="BundleName" Text="Backup de arquivos" ToolTip="Nome do backup" Margin="0,0,0,8"/><Button x:Name="BackupButton" Content="Planejar backup → servidor…" Click="Backup_Click"/></StackPanel></Grid>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="BrowserStatus" Text="Somente raízes autorizadas localmente no agente aparecem. Não há acesso fora desses escopos." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,12"/>
  <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Backups de arquivos no servidor" FontWeight="SemiBold" Margin="0,0,0,8"/><DataGrid x:Name="Bundles" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="140"/><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Entradas" Binding="{Binding EntryCount}" Width="75"/><DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="105"/><DataGridTextColumn Header="Criado em" Binding="{Binding Created}" Width="150"/></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button x:Name="VerifyBundleButton" Content="Verificar hashes" Click="VerifyBundle_Click"/><Button Content="Ver manifesto" Style="{StaticResource SecondaryButton}" Click="BundleDetails_Click"/><Button x:Name="ImportFileButton" Content="Importar arquivo local…" Style="{StaticResource SecondaryButton}" Click="ImportLocalFile_Click"/><Button x:Name="ImportFolderButton" Content="Importar pasta local…" Style="{StaticResource SecondaryButton}" Click="ImportLocalFolder_Click"/></WrapPanel></Grid>
   <StackPanel Grid.Column="2"><TextBlock Text="Restaurar em pasta NOVA no cliente" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="RestoreDevice" DisplayMemberPath="Label" SelectionChanged="RestoreDevice_SelectionChanged" Padding="7" Margin="0,0,0,8"/><ComboBox x:Name="RestoreRoot" DisplayMemberPath="DisplayLabel" Padding="7" Margin="0,0,0,8"/><TextBox x:Name="RestoreFolder" ToolTip="Nova pasta relativa à raiz de destino" Margin="0,0,0,8"/><CheckBox x:Name="RestoreConsent" Content="Autorizo gravar este backup no cliente selecionado." Margin="0,0,0,8"/><Button x:Name="RestoreButton" Content="Planejar restauração…" HorizontalAlignment="Left" Click="Restore_Click"/><TextBlock Text="A pasta de destino não pode existir. Sem sobrescrever, mesclar ou executar os arquivos. Arquivos em uso não têm garantia de snapshot VSS." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0"/></StackPanel>
  </Grid>
 </Grid></ScrollViewer>
</UserControl>
